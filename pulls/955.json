    "title": "qt: filter addhdkey from RPC console history",
    "user": {
      "login": "mateusz-klatt",
      "id": 107385657,
      "node_id": "U_kgDOBmaTOQ",
      "avatar_url": "https://avatars.githubusercontent.com/u/107385657?v=4",
